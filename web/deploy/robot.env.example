# Copy to robot.env and edit for the deployment machine. This is Bash syntax.
# The deployment scripts define APP_DIR before sourcing this file.
# Do not commit robot.env: it may contain database credentials.
ROBOT_APP_DIR="${APP_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
ROS_JAVA_WS="$HOME/ros2_java_ws"
ROS_DISTRO="humble"
# Single consolidated navigation workspace (all nav packages + deps).
NAV_WS="$HOME/blueant_nav_ws"
ROBOT_JAR="$ROBOT_APP_DIR/RobotSystem-1.0.0.jar"
ROBOT_CONFIG="$ROBOT_APP_DIR/application.yml"
ROBOT_LOG_DIR="$ROBOT_APP_DIR/runtime/logs"
ROBOT_RUN_DIR="$ROBOT_APP_DIR/runtime/run"
ROBOT_START_DELAY_SEC="3"
ROBOT_PCD_DIR="$ROBOT_APP_DIR/pcd"
# 初始定位地图（完整 PCD 文件路径）；留空 = 无初始地图，等待运行时 /map_path 热切换
BLUEANT_MAP_PCD=""
ROBOT_MAP_DIR="$ROBOT_APP_DIR/maps"
ROBOT_FILES_DIR="$ROBOT_APP_DIR/runtime/files"
ROBOT_STATIC_MAPS_DIR="$ROBOT_APP_DIR/runtime/static-maps"
# 可选：前端静态目录；缺省自动取（源码模式=<部署根>/frontend；deb 模式=<安装根>/web-ui）
# ROBOT_WEB_UI_DIR="$ROBOT_APP_DIR/frontend"
ROBOT_WEB_PORT="8088"
ROBOT_BROWSER_AUTO_OPEN="false"
ROBOT_ROSBRIDGE_URL="ws://localhost:9090"
ROBOT_PLC_HOST="192.168.8.30"
ROBOT_PLC_PORT="502"
ROBOT_JAVA_PLC_ENABLED="false"
ROBOT_DB_URL="jdbc:mysql://localhost:3306/db_ant?serverTimezone=Asia/Shanghai"
ROBOT_DB_USERNAME="root"
# Required. Set this only in deploy/robot.env on the target machine.
ROBOT_DB_PASSWORD=""
